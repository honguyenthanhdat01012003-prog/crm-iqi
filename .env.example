# Server port
PORT=4000

# CORS allowed origins (comma-separated, leave empty to allow all origins — hiện origin:true)
# Ví dụ web + Capacitor iOS/Android:
# ALLOWED_ORIGINS=https://crm-iqi.id.vn,capacitor://localhost,ionic://localhost,http://localhost
ALLOWED_ORIGINS=

# Node environment
NODE_ENV=production

# ========== DATABASE ==========
# Chế độ mặc định: SQLite local (file server/data/crm.db)
# Nếu muốn dùng Turso cloud, bỏ comment 2 dòng dưới:
# TURSO_URL=libsql://db-xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
#
# Nếu không đặt TURSO_URL, app tự động dùng SQLite local trên VPS (nhanh hơn nhiều)

# ========== AUTO-SYNC ==========
# Tự động sync Google Sheets mỗi X millisecond (mặc định: 30000 = 30 giây)
# SYNC_INTERVAL_MS=30000

# ========== REDIS (cache API — optional) ==========
# Cài Redis trên aaPanel → App Store → Redis → Start
# Mặc định thử redis://127.0.0.1:6379 nếu không set REDIS_URL
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_CACHE_TTL_SEC=60
# REDIS_ENABLED=0   # tắt hẳn (chỉ dùng RAM cache Node)

# ========== FORCE APP UPDATE (iOS / Android) ==========
# Bật chặn bản cũ: FORCE_APP_UPDATE=1 (mặc định). Tắt: FORCE_APP_UPDATE=0
# Sau khi TestFlight/App Store có bản mới, set min = version mới (vd 1.4.0)
# MIN_IOS_APP_VERSION=1.4.0
# MIN_ANDROID_APP_VERSION=1.4.0
# Link mở store / TestFlight (nút "Cập nhật ngay")
# IOS_STORE_URL=https://testflight.apple.com/join/XXXX
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=vn.id.crmiqi.app
# FORCE_UPDATE_MESSAGE=Vui lòng cập nhật ứng dụng để tiếp tục dùng CRM.

# ========== PERPLEXITY AI ==========
# API key cho Perplexity Sonar (phân tích thị trường BĐS)
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxx
